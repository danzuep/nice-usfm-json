<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.*" />
    <!-- Prevent importing TUnit's MSBuild buildTransitive targets (which bring
         Microsoft.Testing.Platform.MSBuild) on SDKs where they are incompatible.
         We still consume the runtime/test assemblies but exclude the build assets. -->
    <PackageReference Include="TUnit.Engine" Version="1.*" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../samples/**" LinkBase="Data" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\USFM\USFM.csproj" />
  </ItemGroup>

</Project>
